NODE_ENV=production
APP_BASE_URL=https://screenprintingbali.com
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u621154993_spbprod
DB_USER=u621154993_spbapp
DB_PASSWORD=replace_with_a_long_random_password

# Generate a random value which decodes from base64 to exactly 32 bytes.
MFA_ENCRYPTION_KEY=replace_with_32_random_bytes_encoded_as_base64
ADMIN_BOOTSTRAP_TOKEN=temporary_long_random_token_remove_after_admin_setup

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace_with_sender_mailbox
SMTP_PASSWORD=replace_with_mailbox_password
MAIL_FROM=Screen Printing Bali <replace_with_sender_mailbox>

# Optional customer Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://screenprintingbali.com/api/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Must be writable and persist through application redeployments.
PORTFOLIO_STORAGE_DIR=/home/u621154993/domains/screenprintingbali.com/private/portfolio

# Optional AI live chat. Keep the API key server-side in Hostinger.
ZROUTER_API_KEY=
ZROUTER_MODEL=gpt-5.4
